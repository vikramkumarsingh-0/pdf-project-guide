## 10. The Recommendation Engine

File: `src/lib/recommendation.ts` — a dependency-free TF / cosine-similarity ranker.

```ts
export const tokenize = (text: string) =>
  text.toLowerCase().replace(/[^a-z0-9\s-]/g, ' ').split(/\s+/)
      .filter(x => x.length > 1 && !STOP.has(x));

export function cosineSimilarity(a: Map<string, number>, b: Map<string, number>) {
  const keys = new Set([...a.keys(), ...b.keys()]);
  let dot = 0, aa = 0, bb = 0;
  keys.forEach(k => {
    const x = a.get(k) || 0, y = b.get(k) || 0;
    dot += x * y; aa += x * x; bb += y * y;
  });
  return aa && bb ? dot / (Math.sqrt(aa) * Math.sqrt(bb)) : 0;
}

export function rankMaterials(materials, profileText, enrolled = []) {
  const q = tf(tokenize(profileText));
  return materials.map(material => {
    const subject = material.subjects?.name || '';
    const content = cosineSimilarity(
      q,
      tf(tokenize(`${material.title} ${material.description} ${subject} ${material.tags.join(' ')}`))
    );
    const subjectScore = enrolled.includes(material.subject_id) ? 1 : 0;
    const rating       = Math.min(1, Number(material.average_rating) / 5);
    const popularity   = Math.min(1, material.rating_count / 25);

    const score = Math.min(1,
      content * 0.50 +
      (rating * 0.7 + popularity * 0.3) * 0.25 +
      subjectScore * 0.15 +
      rating * 0.10);

    const reason =
      content > 0.25   ? 'Matches your recent interests'
      : subjectScore   ? 'Recommended for an enrolled subject'
      : rating > 0.82  ? 'Highly rated by students'
      : 'Popular learning resource';

    return { ...material, score, reason };
  }).sort((a, b) => b.score - a.score).slice(0, 10);
}
```

**Weighting:** 50 % content similarity, 25 % quality/popularity blend, 15 % enrolled-subject boost, 10 % rating quality. Every result carries a human-readable `reason`, so recommendations are explainable rather than a black box. Cold-start users are handled by the onboarding questionnaire, which supplies the initial `profileText`.

